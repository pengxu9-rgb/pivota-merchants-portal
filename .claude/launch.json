{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "recovery-v2-mock-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/recovery-v2-mock-api.mjs"
      ],
      "port": 8787
    },
    {
      "name": "recovery-v2-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_FEATURE_RECOVERY_V2=true NEXT_PUBLIC_API_URL=http://127.0.0.1:8787 npx next dev -p 3100"
      ],
      "port": 3100
    },
    {
      "name": "recovery-v2-start",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "NEXT_TELEMETRY_DISABLED=1 npx next start -p 3200"
      ],
      "port": 3200
    }
  ]
}
