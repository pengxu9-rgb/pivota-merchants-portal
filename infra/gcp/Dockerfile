# syntax=docker/dockerfile:1
# Next.js 15 on Cloud Run. Mirrors the Node 22.x runtime the Vercel project used.

FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time, not read at runtime.
ARG NEXT_PUBLIC_CONSUMER_ANSWER_ENABLED=false
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_ACP
ARG NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_V1
ARG NEXT_PUBLIC_ENABLE_STORELESS_BRAND_CATALOG
ARG NEXT_PUBLIC_FEATURE_AI_READINESS_HOME
ARG NEXT_PUBLIC_FEATURE_REPORT_SUMMARY_VIEW
ARG NEXT_PUBLIC_FEATURE_SHARE_LINK
ENV NEXT_PUBLIC_CONSUMER_ANSWER_ENABLED=$NEXT_PUBLIC_CONSUMER_ANSWER_ENABLED \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_ACP=$NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_ACP \
    NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_V1=$NEXT_PUBLIC_FEATURE_PLATFORM_ORDERS_V1 \
    NEXT_PUBLIC_ENABLE_STORELESS_BRAND_CATALOG=$NEXT_PUBLIC_ENABLE_STORELESS_BRAND_CATALOG \
    NEXT_PUBLIC_FEATURE_AI_READINESS_HOME=$NEXT_PUBLIC_FEATURE_AI_READINESS_HOME \
    NEXT_PUBLIC_FEATURE_REPORT_SUMMARY_VIEW=$NEXT_PUBLIC_FEATURE_REPORT_SUMMARY_VIEW \
    NEXT_PUBLIC_FEATURE_SHARE_LINK=$NEXT_PUBLIC_FEATURE_SHARE_LINK \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
ENV PORT=8080 HOSTNAME=0.0.0.0
EXPOSE 8080
CMD ["node", "server.js"]
